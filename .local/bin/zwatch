#!/bin/bash

# Usage: zwatch <file.typ>
#
# Watches a Typst file for changes, recompiling it to watch.pdf in the current
# directory, and opens it in zathura (which auto-reloads on change). Returns
# immediately; once zathura is closed, the watcher is killed and watch.pdf is
# removed in the background.

usage() {
    cat <<'EOF'
Usage: zwatch <file.typ>

Watches a Typst file for changes, recompiling it to watch.pdf in the current
directory, and opens it in zathura (which auto-reloads on change). Returns
immediately; once zathura is closed, the watcher is killed and watch.pdf is
removed in the background.
EOF
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 1 ]; then
    echo "Error: expected 1 argument (a .typ file), got $#" >&2
    usage >&2
    exit 1
fi

if [ ! -f "$1" ]; then
    echo "Error: file '$1' not found" >&2
    exit 1
fi

for dep in typst zathura; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        echo "Error: '$dep' not found in PATH" >&2
        exit 1
    fi
done

log_file="$(mktemp)"
typst watch "$1" "watch.pdf" >"$log_file" 2>&1 &
watch_pid=$!
disown "$watch_pid"

# typst watch doesn't exit on a compile error -- it just keeps watching and
# never produces watch.pdf -- so on top of checking the process is still
# alive, give up after a timeout and surface its output instead of hanging.
wait_iters=0
max_wait_iters=150 # 150 * 0.1s = 15s
until [ -f "watch.pdf" ]; do
    if ! kill -0 "$watch_pid" 2>/dev/null; then
        echo "Error: typst watch exited before producing watch.pdf" >&2
        cat "$log_file" >&2
        rm -f "$log_file"
        exit 1
    fi
    wait_iters=$((wait_iters + 1))
    if [ "$wait_iters" -ge "$max_wait_iters" ]; then
        echo "Error: typst watch hasn't produced watch.pdf after 15s -- likely a compile error in '$1':" >&2
        cat "$log_file" >&2
        kill "$watch_pid" 2>/dev/null
        rm -f "$log_file"
        exit 1
    fi
    sleep 0.1
done
rm -f "$log_file"

(
    zathura "watch.pdf"
    kill "$watch_pid" 2>/dev/null
    rm -f "watch.pdf"
) &
disown
