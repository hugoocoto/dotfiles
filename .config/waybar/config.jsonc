{
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "spacing": 5,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["wireplumber", "battery", "hyprland/language", "network", "clock"],

"hyprland/workspaces": {
    "format": "{name} {windows}",
    "workspace-taskbar": {
        "enable": true,
        "update-active-window": false,
        "format": "{icon}"
    },
    "persistent-workspaces": {
        "*": [1,2,3,4,5]
    }
},

    "hyprland/window": {
        "format": "[{}]"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
                    "mode"          : "month",
                    "iso8601" : true,
                    "on-scroll"     : 1,
                    "format": {
                              "days":     "<span color='#d4be98'><b>{}</b></span>",
                              "weekdays": "<span color='#7daea3'><b>{}</b></span>",
                              "today":    "<span color='#e78a4e'><b><u>{}</u></b></span>"
                              }
                    },
    },

    "wireplumber": {
        "format": "volume: {volume}%",
        "format-muted": "muted",
        "max-volume": 100,
        "scroll-step": 5
    },

    "battery": {
        "bat": "BAT1",
        "interval": 15,
        "warning-low": 20,
        "format": "battery: {capacity}%",
    },

    "network": {
        "format": "network: {essid}",
        "format-disconnected": "offline"
    },

    "bluetooth": {
        "format": "\udb80\udcaf",
        "format-disabled": "\udb80\udcb2",
        "format-connected": "\udb80\udcb1",
    },

    "hyprland/language": {
        "format": "{short}"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\udb80\udd76",
            "deactivated": "\udb83\udfaa"
        }
    }
},
